@model List<YarimKalanlar.Models.Haber>
@{
    ViewData["Title"] = "Yönetim Paneli";
    var adSoyad = ViewBag.AdSoyad as string ?? "Editör";
}

<section class="container admin-section">
    <div class="admin-header">
        <div>
            <h1>Yönetim Paneli</h1>
            <p>Hoş geldiniz, <strong>@adSoyad</strong> — Toplam @Model.Count haber</p>
        </div>
        <a asp-action="Yeni" class="btn-primary">+ Yeni Haber</a>
    </div>

    <div class="admin-tablo-wrap">
        <table class="admin-tablo">
            <thead>
                <tr>
                    <th>Başlık</th>
                    <th>Yazar</th>
                    <th>Tarih</th>
                    <th>Görüntülenme</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var h in Model)
                {
                    <tr>
                        <td>
                            <a asp-controller="Haber" asp-action="Detay" asp-route-id="@h.Id" target="_blank">
                                @h.Baslik
                            </a>
                        </td>
                        <td>@h.Yazar</td>
                        <td>@h.YayinTarihi.TrSadeceTarih()</td>
                        <td>@h.Goruntulenme</td>
                        <td class="tablo-islem">
                            <a asp-action="Duzenle" asp-route-id="@h.Id" class="btn-mini">Düzenle</a>
                            <form asp-action="Sil" asp-route-id="@h.Id" method="post" style="display:inline"
                                  onsubmit="return confirm('Bu haberi silmek istediğinizden emin misiniz?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-mini btn-sil">Sil</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
